{
  "name": "intellij-java-kotlin-navigation",
  "displayName": "IntelliJ Java/Kotlin Navigation",
  "description": "IntelliJ-style usages and interface / implementation / override navigation ('7 usages', '1 implementation', '↑ Interface' hints) in Java and Kotlin. Works on top of any language server (e.g. JetBrains' 'Java and Kotlin by IntelliJ IDEA').",
  "version": "1.1.1",
  "publisher": "andreashuthe",
  "author": "Andreas Huth",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/andreashuthe/intellij-java-kotlin-navigation.git"
  },
  "bugs": {
    "url": "https://github.com/andreashuthe/intellij-java-kotlin-navigation/issues"
  },
  "homepage": "https://github.com/andreashuthe/intellij-java-kotlin-navigation#readme",
  "galleryBanner": {
    "color": "#1E1F22",
    "theme": "dark"
  },
  "pricing": "Free",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "intellij",
    "java",
    "kotlin",
    "implementation",
    "override",
    "navigation",
    "code vision",
    "usages",
    "find references",
    "inlay hints",
    "go to implementation",
    "spring",
    "go to test",
    "navigate to test",
    "method hierarchy"
  ],
  "icon": "media/logo.png",
  "activationEvents": [
    "onLanguage:java",
    "onLanguage:kotlin"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "intellijNav.goToImplementations",
        "title": "Go to Implementation(s) / Overriding Members",
        "category": "IntelliJ Nav"
      },
      {
        "command": "intellijNav.goToSuper",
        "title": "Go to Super Method / Interface",
        "category": "IntelliJ Nav"
      },
      {
        "command": "intellijNav.showUsages",
        "title": "Show Usages",
        "category": "IntelliJ Nav"
      },
      {
        "command": "intellijNav.goToTest",
        "title": "Go to Test / Test Subject",
        "category": "IntelliJ Nav"
      },
      {
        "command": "intellijNav.createTest",
        "title": "Create Test",
        "category": "IntelliJ Nav"
      },
      {
        "command": "intellijNav.nextMember",
        "title": "Next Member (Method / Field / Class)",
        "category": "IntelliJ Nav"
      },
      {
        "command": "intellijNav.previousMember",
        "title": "Previous Member (Method / Field / Class)",
        "category": "IntelliJ Nav"
      },
      {
        "command": "intellijNav.showMethodHierarchy",
        "title": "Method Hierarchy",
        "category": "IntelliJ Nav"
      },
      {
        "command": "intellijNav.refreshMethodHierarchy",
        "title": "Refresh Method Hierarchy",
        "category": "IntelliJ Nav",
        "icon": "$(refresh)"
      },
      {
        "command": "intellijNav.refresh",
        "title": "Refresh Navigation Hints",
        "category": "IntelliJ Nav"
      }
    ],
    "configuration": {
      "title": "IntelliJ Java/Kotlin Navigation",
      "properties": {
        "intellijNav.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable IntelliJ-style inheritance navigation (hints, hover, commands)."
        },
        "intellijNav.languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "java",
            "kotlin"
          ],
          "description": "Language IDs for which navigation hints are computed."
        },
        "intellijNav.inlayHints": {
          "type": "boolean",
          "default": true,
          "description": "Show clickable IntelliJ-style hints at the end of declarations, e.g. '1 implementation' or '↑ EntityRepository'. Cmd/Ctrl+Click to navigate."
        },
        "intellijNav.usages": {
          "type": "boolean",
          "default": true,
          "description": "Show IntelliJ-style usage counts ('7 usages') for classes, methods and fields. Only members on screen are counted. ⌘/Ctrl+Click shows the usages."
        },
        "intellijNav.codeLens": {
          "type": "boolean",
          "default": false,
          "description": "Show the same links as CodeLens above each declaration (plain click, but takes an extra line)."
        },
        "intellijNav.clickLineNumber": {
          "type": "boolean",
          "default": false,
          "description": "Clicking the line number of a declaration with implementations/super methods navigates there (instead of selecting the line)."
        },
        "intellijNav.showOnTypes": {
          "type": "boolean",
          "default": true,
          "description": "Also show icons on class/interface declarations (implemented by / implements)."
        },
        "intellijNav.refreshDelay": {
          "type": "number",
          "default": 1000,
          "minimum": 100,
          "description": "Delay in ms after an edit before the icons are recomputed."
        },
        "intellijNav.maxConcurrentRequests": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "description": "Maximum number of parallel language-server requests per file."
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "intellijNav.goToTest",
          "when": "editorLangId =~ /^(java|kotlin)$/",
          "group": "navigation@90"
        },
        {
          "command": "intellijNav.showUsages",
          "when": "editorLangId =~ /^(java|kotlin)$/",
          "group": "navigation@91"
        },
        {
          "command": "intellijNav.showMethodHierarchy",
          "when": "editorLangId =~ /^(java|kotlin)$/",
          "group": "navigation@92"
        }
      ],
      "commandPalette": [
        {
          "command": "intellijNav.goToTest",
          "when": "editorLangId =~ /^(java|kotlin)$/"
        },
        {
          "command": "intellijNav.createTest",
          "when": "editorLangId =~ /^(java|kotlin)$/"
        },
        {
          "command": "intellijNav.nextMember",
          "when": "editorLangId =~ /^(java|kotlin)$/"
        },
        {
          "command": "intellijNav.previousMember",
          "when": "editorLangId =~ /^(java|kotlin)$/"
        },
        {
          "command": "intellijNav.showUsages",
          "when": "editorLangId =~ /^(java|kotlin)$/"
        },
        {
          "command": "intellijNav.goToImplementations",
          "when": "editorLangId =~ /^(java|kotlin)$/"
        },
        {
          "command": "intellijNav.goToSuper",
          "when": "editorLangId =~ /^(java|kotlin)$/"
        },
        {
          "command": "intellijNav.showMethodHierarchy",
          "when": "editorLangId =~ /^(java|kotlin)$/"
        },
        {
          "command": "intellijNav.refreshMethodHierarchy",
          "when": "intellijNav.hasMethodHierarchy"
        }
      ],
      "view/title": [
        {
          "command": "intellijNav.refreshMethodHierarchy",
          "when": "view == intellijNav.methodHierarchy",
          "group": "navigation"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "intellijNav.methodHierarchy",
          "name": "Method Hierarchy",
          "when": "intellijNav.hasMethodHierarchy",
          "icon": "$(type-hierarchy-sub)"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test test/*.test.js",
    "test:integration": "npm run compile && node integration-test/runTest.js",
    "test:perf": "npm run compile && node integration-test/perf/run.js",
    "test:perf:workflows": "npm run compile && node integration-test/perf/run.js 15 perf-workflows.json workflows",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "~1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "typescript": "^7.0.2"
  }
}
